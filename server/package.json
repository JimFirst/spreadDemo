{
  "name": "spreadjs-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/kill-port.js && tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext ts --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts --fix",
    "format": "prettier --write src",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:init-collab": "tsx scripts/init-collaboration-db.ts",
    "kill-port": "node scripts/kill-port.js"
  },
  "dependencies": {
    "@grapecity-software/js-collaboration": "^18.2.5",
    "@grapecity-software/js-collaboration-ot": "^18.2.5",
    "@grapecity-software/js-collaboration-ot-postgres": "^18.2.5",
    "@grapecity-software/js-collaboration-presence": "^18.2.5",
    "@grapecity-software/spread-sheets-collaboration": "^18.2.5",
    "@prisma/client": "^5.6.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.20.0",
    "socket.io": "^4.6.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.9.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.53.0",
    "prettier": "^3.1.0",
    "prisma": "^5.6.0",
    "tsx": "^4.6.0",
    "typescript": "^5.2.2"
  },
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
